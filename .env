# ==========================================
# SERVER CONFIGURATION
# ==========================================
NODE_ENV=development
PORT=5000
IP=10.10.26.159

# ==========================================
# DATABASE (MongoDB)
# ==========================================
DATABASE_URL=mongodb://127.0.0.1:27017/motly_server

# ==========================================
# SECURITY & BCRYPT
# ==========================================
BCRYPT_SALT_ROUNDS=10

# ==========================================
# JWT CONFIGURATION
# ==========================================
JWT_SECRET=motly_super_secret_jwt_access_token_key_2024
JWT_EXPIRE_IN=1d
JWT_REFRESH_SECRET=motly_super_secret_jwt_refresh_token_key_2024
JWT_REFRESH_EXPIRE_IN=30d
ISSUER=motly_server
AUDIENCE=motly_users
TOKEN_VERSION=1.0.0

# ==========================================
# SUPER ADMIN CREDENTIALS (DB Seed)
# ==========================================
SUPER_ADMIN_EMAIL=admin@motly.com
SUPER_ADMIN_PASSWORD=Admin@123456
CONFIRM_PASSWORD=Admin@123456

# ==========================================
# REDIS & BULLMQ
# ==========================================
# Note: config/index.ts expects 'redisIP' exactly
redisIP=127.0.0.1
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
BULLMQIP=127.0.0.1
BULLMQPORT=6379

# ==========================================
# ELASTICSEARCH
# ==========================================
ELASTICSEARCH_CAR_INDEX=cars

# ==========================================
# STRIPE PAYMENT GATEWAY
# ==========================================
STRIPE_API_SECRET=sk_test_your_stripe_secret_key
WEBHOOK_SECRET=whsec_your_webhook_secret

# ==========================================
# EMAIL / SMTP (Nodemailer)
# ==========================================
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_email_app_password
EMAIL_FROM=no-reply@motly.com

# ==========================================
# SOCIAL AUTH (OAuth)
# ==========================================
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
FACEBOOK_CLIENT_ID=your_facebook_client_id
FACEBOOK_CLIENT_SECRET=your_facebook_client_secret

# ==========================================
# TWILIO SMS
# ==========================================
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_NUMBER=+1234567890
