# ==========================================
# SERVER CONFIGURATION
# ==========================================
NODE_ENV=development
PORT=5000
IP=127.0.0.1

# ==========================================
# DATABASE (MongoDB)
# ==========================================
DATABASE_URL=mongodb://127.0.0.1:27017/motly_server

# ==========================================
# SECURITY & BCRYPT
# ==========================================
BCRYPT_SALT_ROUNDS=10

# ==========================================
# JWT CONFIGURATION
# ==========================================
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRE_IN=1d
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here
JWT_REFRESH_EXPIRE_IN=30d
ISSUER=motly_server
AUDIENCE=motly_users
TOKEN_VERSION=1.0.0

# ==========================================
# SUPER ADMIN CREDENTIALS (DB Seed)
# ==========================================
SUPER_ADMIN_EMAIL=admin@motly.com
SUPER_ADMIN_PASSWORD=your_super_admin_password
CONFIRM_PASSWORD=your_super_admin_password

# ==========================================
# REDIS & BULLMQ
# ==========================================
# Note: config/index.ts expects 'redisIP' exactly
redisIP=127.0.0.1
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
BULLMQIP=127.0.0.1
BULLMQPORT=6379

# ==========================================
# ELASTICSEARCH
# ==========================================
ELASTICSEARCH_CAR_INDEX=cars

# ==========================================
# STRIPE PAYMENT GATEWAY
# ==========================================
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_API_SECRET=sk_test_...
WEBHOOK_SECRET=whsec_...
# Optional: only for Flutter PaymentSheet (public, not secret)
STRIPE_PUBLISHABLE_KEY=pk_test_...
# Hosted Checkout return URLs (optional — server falls back to /car/payments/checkout-return)
STRIPE_SUCCESS_URL=https://your-app.example/payment/success?session_id={CHECKOUT_SESSION_ID}
STRIPE_CANCEL_URL=https://your-app.example/payment/cancel

# ==========================================
# EMAIL / SMTP (Nodemailer)
# ==========================================
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_email_app_password
EMAIL_FROM=no-reply@motly.com

# ==========================================
# SOCIAL AUTH (OAuth)
# ==========================================
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
FACEBOOK_CLIENT_ID=your_facebook_client_id
FACEBOOK_CLIENT_SECRET=your_facebook_client_secret

# ==========================================
# TWILIO SMS
# ==========================================
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_NUMBER=+1234567890

# ==========================================
# AMADEUS CARS QUICK-CONNECT (AQC)
# ==========================================
# PDT: https://test.travel.api.amadeus.com
# PRD: https://travel.api.amadeus.com (requires AMA_ALLOW_PRD=true)
AMA_BASE_URL=https://test.travel.api.amadeus.com
AMA_TEST_API_KEY=your_amadeus_api_key
AMA_API_SECRET=your_amadeus_api_secret
# Optional — only needed for office-bound Enterprise/AQC credentials
AMA_OFFICE_ID=
AMA_COMPANY_CODE=MOTLY
AMA_ALLOW_PRD=false
AMA_INCLUDE_RAW=false
AMA_TIMEOUT_MS=30000
